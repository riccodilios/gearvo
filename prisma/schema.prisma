// Gearvo - Automotive Business Operating System
// Multi-tenant: Platform → Company → Branch → Users
// https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  /// Supabase PostgreSQL. Prefer Transaction pooler (port 6543, pgbouncer=true) on Netlify.
  /// For migrations from CI, Session pooler (port 5432) or direct db host also works.
  url      = env("DATABASE_URL")
}

// ============ PLATFORM / COMPANY / BRANCH ============

model Company {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  email                String?
  phone                String?
  address              String?
  logoUrl              String?
  commercialRegNumber  String? // Saudi CR
  vatNumber            String?
  currency             String    @default("SAR")
  locale               String    @default("en")
  timezone             String    @default("Asia/Riyadh")
  plan                 Plan      @default(TRIAL)
  status               CompanyStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialEndsAt          DateTime?
  suspendedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  branches       Branch[]
  memberships    Membership[]
  customers      Customer[]
  vehicles       Vehicle[]
  suppliers      Supplier[]
  carParts       CarPart[]
  repairOrders   RepairOrder[]
  invoices       Invoice[]
  payments       Payment[]
  installments   Installment[]
  purchaseOrders PurchaseOrder[]
  analyticsEvents AnalyticsEvent[]
  activityLogs   ActivityLog[]
  featureFlags   CompanyFeatureFlag[]
  integrations   CompanyIntegration[]
  sequences      DocumentSequence[]
  expenses       Expense[]
}

enum Plan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  name      String
  slug      String
  phone     String?
  address   String?
  isDefault Boolean   @default(false)
  isArchived Boolean  @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  customers      Customer[]
  vehicles       Vehicle[]
  suppliers      Supplier[]
  carParts       CarPart[]
  repairOrders   RepairOrder[]
  invoices       Invoice[]
  payments       Payment[]
  installments   Installment[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String
  fullName      String
  avatarUrl     String?
  isPlatformAdmin Boolean @default(false)
  preferredLocale String @default("en")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships  Membership[]
  activityLogs ActivityLog[]
}

enum AppRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  BRANCH_MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
  CASHIER
  INVENTORY_MANAGER
  ACCOUNTANT
  RECEPTIONIST
  EMPLOYEE
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  branchId  String? // null = company-wide (Owner/Admin)
  role      AppRole  @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, branchId])
  @@index([companyId])
  @@index([userId])
}

// ============ FEATURE FLAGS & INTEGRATIONS ============

enum FeatureModule {
  CRM
  INVENTORY
  MARKETPLACE
  INSTALLMENTS
  ACCOUNTING
  ANALYTICS
  EMPLOYEES
  AI
  WHATSAPP
  REPORTS
  APPOINTMENTS
  EXPENSES
}

model CompanyFeatureFlag {
  id        String        @id @default(cuid())
  companyId String
  feature   FeatureModule
  enabled   Boolean       @default(true)
  config    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, feature])
  @@index([companyId])
}

enum IntegrationProvider {
  STRIPE
  WHATSAPP
  EMAIL
  SMS
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  ACCOUNTING
  ZATCA
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  PENDING
}

model CompanyIntegration {
  id           String              @id @default(cuid())
  companyId    String
  provider     IntegrationProvider
  status       IntegrationStatus   @default(DISCONNECTED)
  config       Json? // non-secret settings
  secretsEnc   String? // encrypted credentials (never expose to client)
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
}

// ============ AUDIT / ACTIVITY ============

model ActivityLog {
  id         String   @id @default(cuid())
  companyId  String
  branchId   String?
  userId     String?
  action     String // customer.created, invoice.paid, etc.
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

model DocumentSequence {
  id        String @id @default(cuid())
  companyId String
  branchId  String?
  type      String // INV, RO, PO
  year      Int
  lastValue Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, type, year])
}

// ============ CUSTOMER CRM ============

model Customer {
  id                 String    @id @default(cuid())
  companyId          String
  branchId           String
  fullName           String
  phone              String?
  email              String?
  address            String?
  tags               String[]
  notes              String?
  totalSpent         Decimal   @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal   @default(0) @db.Decimal(12, 2)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  repairOrders RepairOrder[]
  invoices     Invoice[]
  payments     Payment[]
  installments Installment[]

  @@index([companyId, branchId, createdAt])
  @@index([companyId, fullName])
}

model Vehicle {
  id           String    @id @default(cuid())
  companyId    String
  branchId     String
  customerId   String
  make         String
  model        String
  year         Int
  licensePlate String?
  vin          String?
  color        String?
  mileage      Int?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repairOrders RepairOrder[]

  @@index([companyId, branchId])
  @@index([customerId])
}

// ============ SUPPLIERS & INVENTORY ============

model Supplier {
  id            String    @id @default(cuid())
  companyId     String
  branchId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  carParts        CarPart[]
  purchaseOrders  PurchaseOrder[]

  @@index([companyId, branchId])
}

model CarPart {
  id             String    @id @default(cuid())
  companyId      String
  branchId       String
  supplierId     String?
  name           String
  partNumber     String?
  costPrice      Decimal   @db.Decimal(12, 2)
  retailPrice    Decimal   @db.Decimal(12, 2)
  stockQuantity  Int       @default(0)
  minStockLevel  Int       @default(5)
  category       String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier           Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  partUsages         RepairOrderPart[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([companyId, branchId])
  @@index([companyId, name])
}

// ============ REPAIR ORDERS ============

model RepairOrder {
  id               String            @id @default(cuid())
  companyId        String
  branchId         String
  customerId       String
  vehicleId        String
  orderNumber      String
  description      String?
  status           RepairOrderStatus @default(PENDING)
  laborCost        Decimal           @default(0) @db.Decimal(12, 2)
  partsCostTotal   Decimal           @default(0) @db.Decimal(12, 2)
  partsRetailTotal Decimal           @default(0) @db.Decimal(12, 2)
  totalPrice       Decimal           @default(0) @db.Decimal(12, 2)
  profit           Decimal           @default(0) @db.Decimal(12, 2)
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  parts    RepairOrderPart[]
  invoice  Invoice?

  @@unique([companyId, orderNumber])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status])
  @@index([customerId, createdAt])
}

enum RepairOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  DELIVERED
  CANCELLED
}

model RepairOrderPart {
  id            String  @id @default(cuid())
  repairOrderId String
  carPartId     String
  quantity      Int
  costPrice     Decimal @db.Decimal(12, 2)
  retailPrice   Decimal @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  carPart     CarPart     @relation(fields: [carPartId], references: [id], onDelete: Restrict)

  @@unique([repairOrderId, carPartId])
}

// ============ INVOICES & PAYMENTS ============

model Invoice {
  id               String        @id @default(cuid())
  companyId        String
  branchId         String
  repairOrderId    String?       @unique
  customerId       String
  invoiceNumber    String
  totalAmount      Decimal       @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  status           InvoiceStatus @default(UNPAID)
  dueDate          DateTime?
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  repairOrder  RepairOrder?  @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]
  payments     Payment[]
  installments Installment[]
  receipts     Receipt[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status])
  @@index([customerId, createdAt])
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(cuid())
  companyId       String
  branchId        String
  invoiceId       String
  customerId      String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  paymentDate     DateTime      @default(now())
  notes           String?
  stripePaymentId String?
  createdAt       DateTime      @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receipts Receipt[]

  @@index([companyId, branchId, paymentDate])
  @@index([customerId, paymentDate])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  STRIPE
  OTHER
}

model Installment {
  id         String            @id @default(cuid())
  companyId  String
  branchId   String
  invoiceId  String
  customerId String
  amount     Decimal           @db.Decimal(12, 2)
  dueDate    DateTime
  status     InstallmentStatus @default(PENDING)
  paidDate   DateTime?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId, dueDate])
  @@index([companyId, status])
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

// ============ MARKETPLACE / PART ORDERS ============

model PurchaseOrder {
  id          String              @id @default(cuid())
  companyId   String
  branchId    String
  supplierId  String
  orderNumber String
  status      PurchaseOrderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]

  @@unique([companyId, orderNumber])
  @@index([companyId, branchId])
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  carPartId       String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  carPart       CarPart       @relation(fields: [carPartId], references: [id], onDelete: Restrict)
}

enum PurchaseOrderStatus {
  PENDING
  ORDERED
  RECEIVED
}

// ============ EXPENSES ============

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  branchId    String
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId, branchId, expenseDate])
}

// ============ RECEIPTS & ANALYTICS ============

model Receipt {
  id         String   @id @default(cuid())
  companyId  String
  invoiceId  String
  paymentId  String
  url        String
  createdAt  DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  companyId String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}
