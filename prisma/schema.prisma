// Gearvo - Mechanic Shop SaaS Platform
// Multi-Tenant PostgreSQL Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ TENANT & AUTH ============

model Tenant {
  id          String   @id @default(cuid())
  name        String   // Shop name
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  logoUrl     String?
  plan        Plan     @default(TRIAL)
  stripeCustomerId   String?
  stripeSubscriptionId String?
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  customers      Customer[]
  vehicles       Vehicle[]
  suppliers      Supplier[]
  carParts       CarPart[]
  repairOrders   RepairOrder[]
  invoices       Invoice[]
  payments       Payment[]
  installments   Installment[]
  purchaseOrders PurchaseOrder[]
  analyticsEvents AnalyticsEvent[]
}

enum Plan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String
  fullName      String
  avatarUrl     String?
  tenantId      String
  role          Role     @default(EMPLOYEE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

// ============ CUSTOMER CRM ============

model Customer {
  id                 String   @id @default(cuid())
  tenantId           String
  fullName           String
  phone              String?
  email              String?
  address            String?
  tags               String[] // VIP, Late payer, Frequent buyer, etc.
  notes              String?
  totalSpent         Decimal  @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]
  repairOrders RepairOrder[]
  invoices   Invoice[]
}

model Vehicle {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  make         String
  model        String
  year         Int
  licensePlate String?
  vin          String?
  color        String?
  mileage      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repairOrders RepairOrder[]
}

// ============ SUPPLIERS & INVENTORY ============

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carParts        CarPart[]
  purchaseOrders  PurchaseOrder[]
}

model CarPart {
  id             String   @id @default(cuid())
  tenantId       String
  supplierId     String?
  name           String
  partNumber     String?
  costPrice      Decimal  @db.Decimal(12, 2)
  retailPrice    Decimal  @db.Decimal(12, 2)
  stockQuantity  Int      @default(0)
  minStockLevel  Int      @default(5)
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  partUsages        RepairOrderPart[]
  purchaseOrderLines PurchaseOrderLine[]
}

// ============ REPAIR ORDERS ============

model RepairOrder {
  id                String   @id @default(cuid())
  tenantId          String
  customerId        String
  vehicleId         String
  orderNumber       String
  description       String?
  status            RepairOrderStatus @default(PENDING)
  laborCost         Decimal  @default(0) @db.Decimal(12, 2)
  partsCostTotal    Decimal  @default(0) @db.Decimal(12, 2)
  partsRetailTotal  Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice        Decimal  @default(0) @db.Decimal(12, 2)
  profit            Decimal  @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  parts    RepairOrderPart[]
  invoice  Invoice?
}

enum RepairOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  DELIVERED
  CANCELLED
}

model RepairOrderPart {
  id             String   @id @default(cuid())
  repairOrderId  String
  carPartId      String
  quantity       Int
  costPrice      Decimal  @db.Decimal(12, 2)
  retailPrice    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  carPart     CarPart     @relation(fields: [carPartId], references: [id], onDelete: Restrict)

  @@unique([repairOrderId, carPartId])
}

// ============ INVOICES & PAYMENTS ============

model Invoice {
  id               String   @id @default(cuid())
  tenantId         String
  repairOrderId    String?  @unique
  customerId       String
  invoiceNumber    String
  totalAmount      Decimal  @db.Decimal(12, 2)
  paidAmount       Decimal  @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal  @default(0) @db.Decimal(12, 2)
  status           InvoiceStatus @default(UNPAID)
  dueDate          DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  repairOrder  RepairOrder? @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]
  payments     Payment[]
  installments Installment[]
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  customerId  String
  amount      Decimal  @db.Decimal(12, 2)
  method      PaymentMethod
  paymentDate DateTime @default(now())
  notes       String?
  stripePaymentId String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  STRIPE
  OTHER
}

model Installment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  customerId  String
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime
  status      InstallmentStatus @default(PENDING)
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

// ============ MARKETPLACE / PART ORDERS ============

model PurchaseOrder {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  orderNumber String  // e.g. PO-2024-001
  status     PurchaseOrderStatus @default(PENDING)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  carPartId       String
  quantity        Int
  unitCost        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  carPart       CarPart       @relation(fields: [carPartId], references: [id], onDelete: Restrict)
}

enum PurchaseOrderStatus {
  PENDING   // Draft / not sent
  ORDERED   // Sent to supplier
  RECEIVED  // Received, stock updated
}

// ============ RECEIPTS & ANALYTICS ============

model Receipt {
  id          String   @id @default(cuid())
  invoiceId   String
  paymentId   String
  url         String   // S3/Cloudinary URL
  createdAt   DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String
  eventType String   // revenue, payment, repair_completed, etc.
  payload   Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
