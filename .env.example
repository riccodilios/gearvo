# Gearvo Environment

# Required
DATABASE_URL="postgresql://user:password@localhost:5432/gearvo?schema=public"

# Auth — required in production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Development only: allow app without Clerk (never in production)
# ALLOW_DEV_AUTH_BYPASS=true
# DEV_USER_CLERK_ID=dev_clerk_owner

# Stripe (SaaS billing + optional shop card payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cron job auth for /api/cron/overdue
CRON_SECRET=change-me-in-production

# Optional encryption key for integration secrets
# INTEGRATION_SECRETS_KEY=32+char-random-string

# Production rate limiting (recommended on Vercel/serverless)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=Axxx
