# Gearvo Environment — Supabase PostgreSQL + Clerk

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL) — REQUIRED
# ---------------------------------------------------------------------------
# App / serverless (Transaction pooler, port 6543):
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Migrations (Direct / Session mode, port 5432) — REQUIRED for prisma migrate:
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Local Supabase (Docker: npx supabase start) — use both pointing at local DB:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---------------------------------------------------------------------------
# Auth (Clerk) — required in production
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Development only: allow app without Clerk (never in production)
# ALLOW_DEV_AUTH_BYPASS=true
# DEV_USER_CLERK_ID=dev_clerk_owner

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Stripe (SaaS billing + optional shop card payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cron job auth for /api/cron/overdue
CRON_SECRET=change-me-in-production

# Optional encryption key for integration secrets
# INTEGRATION_SECRETS_KEY=32+char-random-string

# Production rate limiting (recommended on serverless)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=Axxx

# Demo password override (defaults to GearvoDemo2026!)
# DEMO_PASSWORD=GearvoDemo2026!
